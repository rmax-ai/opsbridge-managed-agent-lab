# OpsBridge Managed Agent Lab — Environment Variables
# Copy to .env and fill in your values

# Anthropic API Key
ANTHROPIC_API_KEY=

# Managed Agents API base URL (default: Anthropic production)
# MANAGED_AGENTS_API_URL=https://api.anthropic.com

# OpsHub MCP server URL (cloud demo)
OPSHUB_MCP_URL=http://localhost:8001

# Vault credential token (demo only)
OPSHUB_AUTH_TOKEN=demo-token-opsbridge-2026

# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI
STREAMLIT_PORT=8501

# Database paths
AUDIT_DB_PATH=data/audit.db
OPS_DB_PATH=data/operations.db
